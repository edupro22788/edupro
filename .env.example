# ===== EDU PRO — متغيرات النشر (Railway) =====
# انسخ هذه القيم في إعدادات Railway → Variables

# قاعدة البيانات (SQLite على القرص الدائم). ضع المسار إلى مجلد /data
DATABASE_URL="file:/data/dev.db"

# سر تشفير الجلسات — غيّره لسلسلة طويلة عشوائية
SESSION_SECRET="replace-with-a-long-random-secret-string"

# البريد: test = يظهر رمز التحقق على الشاشة ، smtp = يرسل بريداً فعلياً
MAIL_MODE="test"

# (اختياري) عند ضبط MAIL_MODE=smtp
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EDU PRO <no-reply@edupro.dz>"

# حساب المدير الذي يُنشأ تلقائياً
ADMIN_EMAIL="admin@edupro.dz"
ADMIN_PASSWORD="admin123"